{
  "target": "branch",
  "enforcement": "active",
  "name": "Allowed branch prefixes",
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/main",
        "refs/heads/dev",
        "refs/heads/release/v*",
        "refs/heads/feat/**",
        "refs/heads/fix/**",
        "refs/heads/chore/**",
        "refs/heads/test/**",
        "refs/heads/dependabot/**"
      ]
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "creation"
    },
    {
      "type": "update"
    }
  ]
}
